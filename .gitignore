# Whitelist approach: ignore everything at root, then allow specific items.
# Once a directory is unignored, its contents are auto-included.
/*

# Allowed top-level items
!/.editorconfig
!/.gitattributes
!/.github/
!/.gitignore
!/CLAUDE.md
!/LICENSE
!/README.md
!/agents/
!/codex-quota-refresh.js
!/commands/
!/docs/
!/plans/
!/scripts/
!/settings.json
!/skills/
!/statusline.js
!/subagent-statusline.js
!/wiki/

# LLM Wiki: pages/index/log are tracked; raw sources are not (copyright/size).
wiki/raw/

# Claude Code plan mode 가 plans/ 루트에 남기는 랜덤 slug 산출물(다른 프로젝트 계획) — 추적하지 않는다.
# §10 핸드오프 plan 은 plans/<YYYY-MM-DD>-<slug>/<slug>-plan.md 로 하위 디렉토리에 있어 이 패턴에 안 걸린다.
/plans/*.md

# Belt-and-suspenders: never push these even if the whitelist is changed by mistake.
.credentials.json
settings.local.json
history.jsonl
*.bak
*.bak.*
tmp_*

# Orca 앱이 설치·갱신하는 skill(심볼릭 링크 — 뒤에 / 를 붙이면 안 맞는다) — 머신 로컬, 추적하지 않는다
/skills/orca-cli

# Python bytecode cache inside whitelisted dirs (e.g. scripts/)
__pycache__/
*.pyc
